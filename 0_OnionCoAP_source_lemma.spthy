theory OnionCoAP begin

// Function signature and definition of the equational theory E

builtins: natural-numbers
functions: check/4, fst/1, g/4, pair/2, prot/3, sdec/2, senc/2,
           snd/1, true/0
equations:
    check(m, prot(m, k, civ), k, civ) = true,
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2

tactic: mine
presort: s
deprio: {id}
  regex"KU\(~circuitID"









rule (modulo E) Proxy_Spawn[color=#bbbbbb]:
   [ ] --> [ !Proxy( $P ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sys_init[color=#bbbbbb]:
   [ Fr( ~circuitID ), !Proxy( $Pa ), !Proxy( $Pb ), !Proxy( $Pc ) ]
  --[
  OnlyOnce( ), Neq( $Pa, $Pb ), Neq( $Pa, $Pc ), Neq( $Pc, $Pb ),
  Neq( $O, $Pa ), Neq( $O, $Pb ), Neq( $O, $Pc ), Neq( $S, $Pa ),
  Neq( $S, $Pb ), Neq( $S, $Pc ), Neq( $O, $S ),
  Circuit( $O, $S, ~circuitID ),
  System( $O, $Pa, $Pb, $Pc, $S, ~circuitID )
  ]->
   [ State_O0( $O, $Pa, $Pb, $Pc, $S, ~circuitID ), !Server( $S ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Client_1_connect_Pa:
   [ State_O0( $O, $Pa, $Pb, $Pc, $S, ~circuitID ), Fr( ~rOA ) ]
  --[
  EdhocRequested( $O, $Pa, ~rOA ), ReachedA( $O, $Pa, ~rOA ),
  ProxyKnowsSource( $Pa, ~circuitID, $O ), RunID( ~rOA ),
  EDHOCout( <'EDHOC', $O, $Pa, ~rOA> )
  ]->
   [
   State_O1( $O, $Pa, $Pb, $Pc, $S, ~circuitID, ~rOA ),
   Out( <'EDHOC', $O, $Pa, ~rOA> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Client_2_connect_Pb:
   [
   State_O1( $O, $Pa, $Pb, $Pc, $S, ~circuitID, rOA ), Fr( ~rOB ),
   !OSCOREcontextInitiator( <$O, $Pa, rOA>, kOA, sOA, $senderID_OA,
                            $O_recipientID_fromA
   )[-]
   ]
  --[
  EdhocRequested( $O, $Pb, ~rOB ), ReachedB( $O, $Pb, ~rOB ),
  RunID( ~rOB ),
  OUT_ClientN( <'please_forward', $Pb, 'EDHOC', $O, $Pb, ~rOB> )
  ]->
   [
   State_O2( $O, $Pa, $Pb, $Pc, $S, ~circuitID, rOA, ~rOB ),
   Out( <$O, $Pa, 
         prot(<
               senc(<'please_forward', $Pb, 'EDHOC', $O, $Pb, ~rOB>,
                    g(kOA, sOA, $senderID_OA, 'Key')), 
               <'AAD', $senderID_OA, %1>, ~circuitID>,
              g(kOA, sOA, $senderID_OA, 'Key'),
              g(kOA, sOA, 'emptybytestring', 'IV')), 
         senc(<'please_forward', $Pb, 'EDHOC', $O, $Pb, ~rOB>,
              g(kOA, sOA, $senderID_OA, 'Key')), 
         'AAD', $senderID_OA, %1>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Client_3_connect_Pc:
   [
   State_O2( $O, $Pa, $Pb, $Pc, $S, ~circuitID, rOA, rOB ),
   Fr( ~rOC ),
   !OSCOREcontextInitiator( <$O, $Pa, rOA>, kOA, sOA, $senderID_OA,
                            $O_recipientID_fromA
   )[-],
   !OSCOREcontextInitiator( <$O, $Pb, rOB>, kOB, sOB, $senderID_OB,
                            $O_recipientID_fromB
   )[-]
   ]
  --[
  EdhocRequested( $O, $Pc, ~rOC ), ReachedC( $O, $Pc, ~rOC ),
  RunID( ~rOC ),
  OUT_ClientN( <'please_forward', $Pc, 'EDHOC', $O, $Pc, ~rOC> ),
  OUT_ClientN( <'please_forward', $Pb, 
                prot(<
                      senc(<'please_forward', $Pc, 'EDHOC', $O, $Pc, ~rOC>,
                           g(kOB, sOB, $senderID_OB, 'Key')), 
                      'AAD', $senderID_OB>,
                     g(kOB, sOB, $senderID_OB, 'Key'),
                     g(kOB, sOB, 'emptybytestring', 'IV')), 
                senc(<'please_forward', $Pc, 'EDHOC', $O, $Pc, ~rOC>,
                     g(kOB, sOB, $senderID_OB, 'Key')), 
                'AAD', $senderID_OB>
  )
  ]->
   [
   State_O3( $O, $Pa, $Pb, $Pc, $S, ~circuitID, rOA, rOB, ~rOC ),
   Out( <$O, $Pa, 
         prot(<
               senc(<'please_forward', $Pb, 
                     prot(<
                           senc(<'please_forward', $Pc, 'EDHOC', $O, $Pc, ~rOC>,
                                g(kOB, sOB, $senderID_OB, 'Key')), 
                           'AAD', $senderID_OB>,
                          g(kOB, sOB, $senderID_OB, 'Key'),
                          g(kOB, sOB, 'emptybytestring', 'IV')), 
                     senc(<'please_forward', $Pc, 'EDHOC', $O, $Pc, ~rOC>,
                          g(kOB, sOB, $senderID_OB, 'Key')), 
                     'AAD', $senderID_OB>,
                    g(kOA, sOA, $senderID_OA, 'Key')), 
               <'AAD', $senderID_OA, %1>, ~circuitID>,
              g(kOA, sOA, $senderID_OA, 'Key'),
              g(kOA, sOA, 'emptybytestring', 'IV')), 
         senc(<'please_forward', $Pb, 
               prot(<
                     senc(<'please_forward', $Pc, 'EDHOC', $O, $Pc, ~rOC>,
                          g(kOB, sOB, $senderID_OB, 'Key')), 
                     'AAD', $senderID_OB>,
                    g(kOB, sOB, $senderID_OB, 'Key'),
                    g(kOB, sOB, 'emptybytestring', 'IV')), 
               senc(<'please_forward', $Pc, 'EDHOC', $O, $Pc, ~rOC>,
                    g(kOB, sOB, $senderID_OB, 'Key')), 
               'AAD', $senderID_OB>,
              g(kOA, sOA, $senderID_OA, 'Key')), 
         'AAD', $senderID_OA, %1>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Client_4_connect_S:
   [
   State_O3( $O, $Pa, $Pb, $Pc, $S, ~circuitID, rOA, rOB, rOC ),
   Fr( ~rOS ),
   !OSCOREcontextInitiator( <$O, $Pa, rOA>, kOA, sOA, $senderID_OA,
                            $O_recipientID_fromA
   )[-],
   !OSCOREcontextInitiator( <$O, $Pb, rOB>, kOB, sOB, $senderID_OB,
                            $O_recipientID_fromB
   )[-],
   !OSCOREcontextInitiator( <$O, $Pc, rOC>, kOC, sOC, $senderID_OC,
                            $O_recipientID_fromC
   )[-]
   ]
  --[
  EdhocRequested( $O, $S, ~rOS ), ReachedS( $O, $S, ~rOS ),
  RunID( ~rOS ),
  OUT_ClientN( <'please_forward', $Pb, 
                prot(<
                      senc(<'please_forward', $Pc, 
                            prot(<
                                  senc(<'please_forward', $S, 'EDHOC', $O, $S, ~rOS>,
                                       g(kOC, sOC, $senderID_OC, 'Key')), 
                                  'AAD', $senderID_OC>,
                                 g(kOC, sOC, $senderID_OC, 'Key'),
                                 g(kOC, sOC, 'emptybytestring', 'IV')), 
                            senc(<'please_forward', $S, 'EDHOC', $O, $S, ~rOS>,
                                 g(kOC, sOC, $senderID_OC, 'Key')), 
                            'AAD', $senderID_OC>,
                           g(kOB, sOB, $senderID_OB, 'Key')), 
                      'AAD', $senderID_OB>,
                     g(kOB, sOB, $senderID_OB, 'Key'),
                     g(kOB, sOB, 'emptybytestring', 'IV')), 
                senc(<'please_forward', $Pc, 
                      prot(<
                            senc(<'please_forward', $S, 'EDHOC', $O, $S, ~rOS>,
                                 g(kOC, sOC, $senderID_OC, 'Key')), 
                            'AAD', $senderID_OC>,
                           g(kOC, sOC, $senderID_OC, 'Key'),
                           g(kOC, sOC, 'emptybytestring', 'IV')), 
                      senc(<'please_forward', $S, 'EDHOC', $O, $S, ~rOS>,
                           g(kOC, sOC, $senderID_OC, 'Key')), 
                      'AAD', $senderID_OC>,
                     g(kOB, sOB, $senderID_OB, 'Key')), 
                'AAD', $senderID_OB>
  ),
  OUT_ClientN( <'please_forward', $Pc, 
                prot(<
                      senc(<'please_forward', $S, 'EDHOC', $O, $S, ~rOS>,
                           g(kOC, sOC, $senderID_OC, 'Key')), 
                      'AAD', $senderID_OC>,
                     g(kOC, sOC, $senderID_OC, 'Key'),
                     g(kOC, sOC, 'emptybytestring', 'IV')), 
                senc(<'please_forward', $S, 'EDHOC', $O, $S, ~rOS>,
                     g(kOC, sOC, $senderID_OC, 'Key')), 
                'AAD', $senderID_OC>
  ),
  OUT_ClientN( <'please_forward', $S, 'EDHOC', $O, $S, ~rOS> )
  ]->
   [
   State_O4( $O, $Pa, $Pb, $Pc, $S, ~circuitID ),
   Out( <$O, $Pa, 
         prot(<
               senc(<'please_forward', $Pb, 
                     prot(<
                           senc(<'please_forward', $Pc, 
                                 prot(<
                                       senc(<'please_forward', $S, 'EDHOC', $O, $S, ~rOS>,
                                            g(kOC, sOC, $senderID_OC, 'Key')), 
                                       'AAD', $senderID_OC>,
                                      g(kOC, sOC, $senderID_OC, 'Key'),
                                      g(kOC, sOC, 'emptybytestring', 'IV')), 
                                 senc(<'please_forward', $S, 'EDHOC', $O, $S, ~rOS>,
                                      g(kOC, sOC, $senderID_OC, 'Key')), 
                                 'AAD', $senderID_OC>,
                                g(kOB, sOB, $senderID_OB, 'Key')), 
                           'AAD', $senderID_OB>,
                          g(kOB, sOB, $senderID_OB, 'Key'),
                          g(kOB, sOB, 'emptybytestring', 'IV')), 
                     senc(<'please_forward', $Pc, 
                           prot(<
                                 senc(<'please_forward', $S, 'EDHOC', $O, $S, ~rOS>,
                                      g(kOC, sOC, $senderID_OC, 'Key')), 
                                 'AAD', $senderID_OC>,
                                g(kOC, sOC, $senderID_OC, 'Key'),
                                g(kOC, sOC, 'emptybytestring', 'IV')), 
                           senc(<'please_forward', $S, 'EDHOC', $O, $S, ~rOS>,
                                g(kOC, sOC, $senderID_OC, 'Key')), 
                           'AAD', $senderID_OC>,
                          g(kOB, sOB, $senderID_OB, 'Key')), 
                     'AAD', $senderID_OB>,
                    g(kOA, sOA, $senderID_OA, 'Key')), 
               <'AAD', $senderID_OA, %1>, ~circuitID>,
              g(kOA, sOA, $senderID_OA, 'Key'),
              g(kOA, sOA, 'emptybytestring', 'IV')), 
         senc(<'please_forward', $Pb, 
               prot(<
                     senc(<'please_forward', $Pc, 
                           prot(<
                                 senc(<'please_forward', $S, 'EDHOC', $O, $S, ~rOS>,
                                      g(kOC, sOC, $senderID_OC, 'Key')), 
                                 'AAD', $senderID_OC>,
                                g(kOC, sOC, $senderID_OC, 'Key'),
                                g(kOC, sOC, 'emptybytestring', 'IV')), 
                           senc(<'please_forward', $S, 'EDHOC', $O, $S, ~rOS>,
                                g(kOC, sOC, $senderID_OC, 'Key')), 
                           'AAD', $senderID_OC>,
                          g(kOB, sOB, $senderID_OB, 'Key')), 
                     'AAD', $senderID_OB>,
                    g(kOB, sOB, $senderID_OB, 'Key'),
                    g(kOB, sOB, 'emptybytestring', 'IV')), 
               senc(<'please_forward', $Pc, 
                     prot(<
                           senc(<'please_forward', $S, 'EDHOC', $O, $S, ~rOS>,
                                g(kOC, sOC, $senderID_OC, 'Key')), 
                           'AAD', $senderID_OC>,
                          g(kOC, sOC, $senderID_OC, 'Key'),
                          g(kOC, sOC, 'emptybytestring', 'IV')), 
                     senc(<'please_forward', $S, 'EDHOC', $O, $S, ~rOS>,
                          g(kOC, sOC, $senderID_OC, 'Key')), 
                     'AAD', $senderID_OC>,
                    g(kOB, sOB, $senderID_OB, 'Key')), 
               'AAD', $senderID_OB>,
              g(kOA, sOA, $senderID_OA, 'Key')), 
         'AAD', $senderID_OA, %1>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) EDHOC_magic[color=#ff73ef]:
   [ In( <'EDHOC', $I, $R, ~runID> )[-], Fr( ~mk ), Fr( ~ms ) ]
  --[
  EdhocCompleted( $I, $R, ~runID ), Neq( $I, $R ),
  OnlyOnceV( ~runID ), Key( ~mk ), Key( ~ms ),
  EDHOCin( <'EDHOC', $I, $R, ~runID> )
  ]->
   [
   !OSCOREcontextInitiator( <$I, $R, ~runID>, ~mk, ~ms, $senderID_IR,
                            $I_recipientID_fromR
   )[-],
   !OSCOREcontextResponder( <$R, $I, ~runID>, ~mk, ~ms,
                            $I_recipientID_fromR, $senderID_IR
   )[-]
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Proxy_all_1_decrypt[color=#ccf3ef]:
   [
   !Proxy( $P )[-],
   In( <$source, $P, 
        prot(<
              senc(outer_plaintext,
                   g(mk_s, ms_s, $P_recipientID_from_source, 'Key')), 
              <'AAD', $P_recipientID_from_source, %counter>, ~circuitID>,
             g(mk_s, ms_s, $P_recipientID_from_source, 'Key'),
             g(mk_s, ms_s, 'emptybytestring', 'IV')), 
        senc(outer_plaintext,
             g(mk_s, ms_s, $P_recipientID_from_source, 'Key')), 
        'AAD', $P_recipientID_from_source, %counter>
   )[+],
   !OSCOREcontextResponder( <$P, $source, rSourceP>, mk_s, ms_s,
                            $senderID_Psource, $P_recipientID_from_source
   )[-]
   ]
  --[
  ProxyKnowsSource( $P, ~circuitID, $source ),
  ForwardedHops( %counter )
  ]->
   [
   State_P1_decrypted_once( $P, outer_plaintext, $source, %counter,
                            ~circuitID
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Proxy_first_3a_forward[color=#cc93ff]:
   [
   State_P1_decrypted_once( $P, <'please_forward', $dest, payload>,
                            $source, %counter, ~circuitID
   ),
   !OSCOREcontextInitiator( <$P, $dest, rPdest>, mk, ms,
                            $senderID_Pdest, $P_recipientID_from_dest
   )[-]
   ]
  --[
  IN_Proxy3_payload( payload, <'please_forward', $dest, payload> ),
  ProxyKnowsDest( $P, ~circuitID, $dest ), Neq( $dest, $source )
  ]->
   [
   Out( <$P, $dest, 
         prot(<senc(payload, g(mk, ms, $senderID_Pdest, 'Key')), 
               <'AAD', $senderID_Pdest, (%counter%+%1)>, ~circuitID>,
              g(mk, ms, $senderID_Pdest, 'Key'),
              g(mk, ms, 'emptybytestring', 'IV')), 
         senc(payload, g(mk, ms, $senderID_Pdest, 'Key')), 'AAD', 
         $senderID_Pdest, (%counter%+%1)>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Proxy_notFirst_2_more_decrypt[color=#ccc3ef]:
   [
   State_P1_decrypted_once( $P,
                            <
                             prot(<
                                   senc(plaintext_out,
                                        g(mk_o, ms_o, $P_recipientID_from_origin, 'Key')), 
                                   'AAD', $P_recipientID_from_source>,
                                  g(mk_o, ms_o, $P_recipientID_from_origin, 'Key'),
                                  g(mk_o, ms_o, 'emptybytestring', 'IV')), 
                             senc(plaintext_out,
                                  g(mk_o, ms_o, $P_recipientID_from_origin, 'Key')), 
                             'AAD', $P_recipientID_from_source>,
                            $source, %counter, ~circuitID
   ),
   !OSCOREcontextResponder( <$P, $origin, rOP>, mk_o, ms_o,
                            $senderID_Porigin, $P_recipientID_from_origin
   )[-]
   ]
  -->
   [
   State_P1_decrypted_twice( $P, plaintext_out, %counter, ~circuitID )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Proxy_notFirst_3a_forward[color=#cc93ff]:
   [
   State_P1_decrypted_twice( $P, <'please_forward', $dest, payload>,
                             %counter, ~circuitID
   ),
   !OSCOREcontextInitiator( <$P, $dest, rPdest>, mk, ms,
                            $senderID_Pdest, $P_recipientID_from_dest
   )[-]
   ]
  --[
  IN_Proxy3_payload( payload, <'please_forward', $dest, payload> ),
  ProxyKnowsDest( $P, ~circuitID, $dest )
  ]->
   [
   Out( <$P, $dest, 
         prot(<senc(payload, g(mk, ms, $senderID_Pdest, 'Key')), 
               <'AAD', $senderID_Pdest, (%counter%+%1)>, ~circuitID>,
              g(mk, ms, $senderID_Pdest, 'Key'),
              g(mk, ms, 'emptybytestring', 'IV')), 
         senc(payload, g(mk, ms, $senderID_Pdest, 'Key')), 'AAD', 
         $senderID_Pdest, (%counter%+%1)>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Proxy_notFirst_3b_edhoc[color=#cc93bb]:
   [
   State_P1_decrypted_once( $P, <'EDHOC', $O, $P, ~rOP>, $source,
                            %counter, ~circuitID
   )
   ]
  --[
  EdhocForwardReceived( $O, $P, ~rOP ), Neq( $O, $source ),
  RunID( ~rOP ), EDHOCout( <'EDHOC', $O, $P, ~rOP> ),
  OnlyOnceV( <$O, $P> )
  ]->
   [ Out( <'EDHOC', $O, $P, ~rOP> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Proxy_connect_next[color=#bb23ef]:
   [ !Proxy( $P )[-], Fr( ~rPn ) ]
  --[
  EdhocRequested( $P, $next, ~rPn ), RunID( ~rPn ),
  EDHOCout( <'EDHOC', $P, $next, ~rPn> ), OnlyOnceV( <$P, $next> )
  ]->
   [ Out( <'EDHOC', $P, $next, ~rPn> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Server_1_decryptAndEdhoc:
   [
   !Server( $S ),
   In( <$source, $S, 
        prot(<
              senc(<'EDHOC', $O, $S, ~rOS>,
                   g(mk_s, ms_s, $S_recipientID_from_source, 'Key')), 
              <'AAD', $S_recipientID_from_source, %counter>, ~circuitID>,
             g(mk_s, ms_s, $S_recipientID_from_source, 'Key'),
             g(mk_s, ms_s, 'emptybytestring', 'IV')), 
        senc(<'EDHOC', $O, $S, ~rOS>,
             g(mk_s, ms_s, $S_recipientID_from_source, 'Key')), 
        'AAD', $S_recipientID_from_source, %counter>
   )[+],
   !OSCOREcontextResponder( <$S, $source, rSourceS>, mk_s, ms_s,
                            $senderID_Ssource, $S_recipientID_from_source
   )[-]
   ]
  --[
  EdhocForwardReceived( $O, $S, ~rOS ), RunID( ~rOS ),
  EDHOCout( <'EDHOC', $O, $S, ~rOS> ), OnlyOnceV( <$O, $S> )
  ]->
   [ Out( <'EDHOC', $O, $S, ~rOS> ) ]

  /* has exactly the trivial AC variant */

lemma types [sources]:
  all-traces
  "∀ payload plaintext_in #i.
    (IN_Proxy3_payload( payload, plaintext_in ) @ #i) ⇒
    ((∃ #j. (!KU( payload ) @ #j) ∧ (#j < #i)) ∨
     (∃ #j. OUT_ClientN( plaintext_in ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ payload plaintext_in #i.
  (IN_Proxy3_payload( payload, plaintext_in ) @ #i)
 ∧
  (∀ #j. (!KU( payload ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #j. (OUT_ClientN( plaintext_in ) @ #j) ⇒ ⊥)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∀ payload plaintext_in #i.
           (IN_Proxy3_payload( payload, plaintext_in ) @ #i)
          ⇒
           ((last(#i)) ∨
            (∃ #j. (!KU( payload ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i)) ∨
            (∃ #j. (OUT_ClientN( plaintext_in ) @ #j) ∧ ¬(last(#j)))))  ∥
         (∃ m #i.
           (EDHOCin( m ) @ #i)
          ∧
           (¬(last(#i))) ∧
           (∀ #j.
             (EDHOCout( m )[-] @ #j) ⇒ ((last(#j)) ∨ (#j = #i) ∨ (#i < #j)))) )
    case case_1
    solve( (last(#i))  ∥
           (∃ #j. (!KU( payload ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i))  ∥
           (∃ #j. (OUT_ClientN( plaintext_in ) @ #j) ∧ ¬(last(#j))) )
      case case_1
      solve( IN_Proxy3_payload( payload, plaintext_in ) @ #i )
        case Proxy_first_3a_forward
        solve( State_P1_decrypted_once( $P,
                                        <'please_forward', $dest, payload>, $source, %counter,
                                        ~circuitID
               ) ▶₀ #i )
          case Proxy_all_1_decrypt
          solve( !KU( prot(<
                            senc(<'please_forward', $dest, payload>,
                                 g(~mk.1, ~ms.1, $P_recipientID_from_source, 'Key')), 
                            <'AAD', $P_recipientID_from_source, %counter>, ~circuitID>,
                           g(~mk.1, ~ms.1, $P_recipientID_from_source, 'Key'),
                           g(~mk.1, ~ms.1, 'emptybytestring', 'IV'))
                 )[+] @ #vk.8 )
            case Client_2_connect_Pb
            by contradiction /* from formulas */
          next
            case Client_3_connect_Pc
            by contradiction /* from formulas */
          next
            case Client_4_connect_S
            by contradiction /* from formulas */
          next
            case Proxy_first_3a_forward_case_1
            solve( (∃ #j.
                     (!KU( <'please_forward', $dest, payload> ) @ #j)
                    ∧
                     (¬(last(#j))) ∧ (#j < #vr.3))  ∥
                   (∃ #j.
                     (OUT_ClientN( <'please_forward', $P, 'please_forward', $dest, 
                                    payload>
                      ) @ #j)
                    ∧
                     ¬(last(#j))) )
              case case_1
              by contradiction /* from formulas */
            next
              case case_2
              by solve( OUT_ClientN( <'please_forward', $P, 'please_forward', 
                                      $dest, payload>
                        ) @ #j.3 )
            qed
          next
            case Proxy_first_3a_forward_case_2
            solve( (∃ #j.
                     (!KU( payload.1 ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #vr.3))  ∥
                   (∃ #j.
                     (OUT_ClientN( <'please_forward', $dest.1, payload.1> ) @ #j)
