restriction max3forward:
  "∀ %c #i. (ForwardedHops( %c ) @ #i) ⇒ (%c ⊏ (%1%+%1%+%1%+%1%+%1))"
  // safety formula

restriction EDHOCintegrity:
  "∀ m #i.
    (EDHOCin( m ) @ #i) ⇒ (∃ #j. (EDHOCout( m )[-] @ #j) ∧ (#j < #i))"

restriction keysAreNotRunIds:
  "∀ k #i. (Key( k ) @ #i) ⇒ (¬(∃ #j. RunID( k ) @ #j))"
  // safety formula

restriction OnlyOnce:
  "∀ #i #j. ((OnlyOnce( ) @ #i) ∧ (OnlyOnce( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction Inequality:
  "∀ x #i. (Neq( x, x ) @ #i) ⇒ (⊥)"
  // safety formula

restriction OnlyOnceV:
  "∀ #i #j x.
    ((OnlyOnceV( x ) @ #i) ∧ (OnlyOnceV( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula



















