                                       g(~mk.4, ~ms.4, 'emptybytestring', 'IV'))
                             )[+] @ #vk.50 )
                        case Client_2_connect_Pb
                        solve( !OSCOREcontextInitiator( <$O, $Pc, ~rOC>, kOC, sOC,
                                                        $senderID_OC, $O_recipientID_fromC
                               )[-] ▶₄ #j )
                          case EDHOC_magic
                          solve( !KU( ~rOC )[-] @ #vk.46 )
                            case Client_3_connect_Pc
