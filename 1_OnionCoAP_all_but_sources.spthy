        next
          case c_prot
          solve( !Proxy( $P )[-] ▶₀ #j )
            case Proxy_Spawn
            solve( !OSCOREcontextResponder( <$P, $O, rSourceP>, mk_s, ms_s,
                                            $senderID_Psource, $P_recipientID_from_source
                   )[-] ▶₂ #j )
              case EDHOC_magic
              by contradiction
            qed
          qed
        qed
      qed
    qed
  qed
qed

