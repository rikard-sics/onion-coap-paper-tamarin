                         ) ▶₀ #j.2 )
                    case Proxy_all_1_decrypt
                    solve( !KU( prot(<
                                      senc(<'EDHOC', $O, $Pb, ~runID>,
                                           g(~mk.2, ~ms.2, $P_recipientID_from_source, 'Key')), 
                                      <'AAD', $P_recipientID_from_source, %counter>, ~circuitID.1>,
                                     g(~mk.2, ~ms.2, $P_recipientID_from_source, 'Key'),
                                     g(~mk.2, ~ms.2, 'emptybytestring', 'IV'))
                           ) @ #vk.19 )
                      case Proxy_first_3a_forward
                      solve( !KU( prot(<
                                        senc(<'please_forward', $Pb, 'EDHOC', $O, $Pb, ~runID>,
                                             g(~mk.3, ~ms.3, $P_recipientID_from_source.1, 'Key')), 
                                        <'AAD', $P_recipientID_from_source.1, %counter>, 
                                        ~circuitID.1>,
                                       g(~mk.3, ~ms.3, $P_recipientID_from_source.1, 'Key'),
                                       g(~mk.3, ~ms.3, 'emptybytestring', 'IV'))
                             ) @ #vk.36 )
                        case Client_2_connect_Pb
                        solve( !KU( senc(<'please_forward', $Pb, 'EDHOC', $O, $Pb, ~runID>,
                                         g(~mk, ~ms, $senderID_OA, 'Key'))
                               ) @ #vk.33 )
                          case Client_2_connect_Pb
                          solve( !KU( senc(<'EDHOC', $O, $Pb, ~runID>,
