                                                                 )[-] @ #j.4 )
                                                            case Proxy_connect_next
                                                            solve( EDHOCout( <'EDHOC', $O, $Pa, ~rOA
                                                                             >
                                                                   )[-] @ #j.4 )
                                                              case Client_1_connect_Pa
                                                              solve( EDHOCout( <'EDHOC', $O, $Pa, 
                                                                                ~rOA>
                                                                     )[-] @ #j.4 )
                                                                case Client_1_connect_Pa
                                                                SOLVED // trace found
                                                              next
                                                                case Proxy_notFirst_3b_edhoc
                                                                by sorry
                                                              next
                                                                case Server_1_decryptAndEdhoc
                                                                by sorry
                                                              qed
                                                            next
                                                              case Proxy_notFirst_3b_edhoc
                                                              by sorry
                                                            next
                                                              case Server_1_decryptAndEdhoc
                                                              by sorry
                                                            qed
                                                          qed
                                                        qed
                                                      next
                                                        case Proxy_first_3a_forward
                                                        by sorry
                                                      next
                                                        case Proxy_notFirst_3a_forward
                                                        by sorry
                                                      next
                                                        case c_prot
                                                        by sorry
                                                      qed
                                                    next
                                                      case Proxy_notFirst_3a_forward
                                                      by sorry
                                                    next
                                                      case c_prot
                                                      by sorry
                                                    qed
                                                  next
                                                    case Server_1_decryptAndEdhoc
                                                    by sorry
                                                  qed
                                                next
