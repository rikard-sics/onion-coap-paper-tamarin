lemma oneCircuitID [reuse]:
  all-traces
  "∀ P cID s #i.
    (ProxyKnowsSource( P, cID, s ) @ #i) ⇒
    (∀ cID2 d #j. (ProxyKnowsDest( P, cID2, d ) @ #j) ⇒ (cID = cID2))"
/*
guarded formula characterizing all counter-examples:
"∃ P cID s #i.
  (ProxyKnowsSource( P, cID, s ) @ #i)
 ∧
  ∃ cID2 d #j. (ProxyKnowsDest( P, cID2, d ) @ #j) ∧ ¬(cID = cID2)"
*/
simplify
solve( !Proxy( $Pa ) ▶₁ #j )
  case Proxy_Spawn
  solve( !Proxy( $Pb ) ▶₂ #j )
    case Proxy_Spawn
    solve( !Proxy( $Pc ) ▶₃ #j )
      case Proxy_Spawn
      solve( ProxyKnowsSource( P, ~circuitID, s ) @ #i )
        case Client_1_connect_Pa
        solve( State_O0( $O, $Pa, $Pb, $Pc, $S, ~circuitID ) ▶₀ #i )
          case Sys_init
          solve( ProxyKnowsDest( $Pa, cID2, d ) @ #j.1 )
            case Proxy_first_3a_forward
            solve( State_P1_decrypted_once( $Pa,
                                            <'please_forward', $dest, payload>, $source, %counter,
                                            ~circuitID.1
                   ) ▶₀ #j.1 )
              case Proxy_all_1_decrypt
              by contradiction
            qed
          next
            case Proxy_notFirst_3a_forward
            solve( State_P1_decrypted_twice( $Pa,
                                             <'please_forward', $dest, payload>, %counter,
                                             ~circuitID.1
                   ) ▶₀ #j.1 )
              case Proxy_notFirst_2_more_decrypt
              by contradiction
            qed
          qed
        qed
      next
        case Proxy_all_1_decrypt
        solve( !KU( prot(<
                          senc(outer_plaintext,
                               g(mk_s, ms_s, $P_recipientID_from_source, 'Key')), 
                          <'AAD', $P_recipientID_from_source, %counter>, ~circuitID>,
                         g(mk_s, ms_s, $P_recipientID_from_source, 'Key'),
                         g(mk_s, ms_s, 'emptybytestring', 'IV'))
               ) @ #vk.5 )
