lemma no_proxy_linkage:
  all-traces
  "∀ O A B C S rOS cID #i #j #k.
    (((System( O, A, B, C, S, cID ) @ #i) ∧
      (EdhocRequested( O, S, rOS ) @ #j)) ∧
     (EdhocCompleted( O, S, rOS ) @ #k)) ⇒
    (∀ P #l #m.
      ((ProxyKnowsSource( P, cID, O ) @ #l) ∧
       (ProxyKnowsDest( P, cID, S ) @ #m)) ⇒
      (⊥))"
/*
guarded formula characterizing all counter-examples:
"∃ O A B C S rOS cID #i #j #k.
  (System( O, A, B, C, S, cID ) @ #i) ∧
  (EdhocRequested( O, S, rOS ) @ #j) ∧
  (EdhocCompleted( O, S, rOS ) @ #k)
 ∧
  ∃ P #l #m.
   (ProxyKnowsSource( P, cID, O ) @ #l) ∧
   (ProxyKnowsDest( P, cID, S ) @ #m)"
*/
by sorry

lemma weak_no_linkage [heuristic={mine}]:
  all-traces
  "∀ O S cID P1 #i #j.
    ((Circuit( O, S, cID ) @ #i) ∧
     (ProxyKnowsSource( P1, cID, O ) @ #j)) ⇒
    (∀ P2 #k. (ProxyKnowsDest( P2, cID, S )[-] @ #k) ⇒ (¬(P1 = P2)))"
/*
guarded formula characterizing all counter-examples:
"∃ O S cID P1 #i #j.
  (Circuit( O, S, cID ) @ #i) ∧ (ProxyKnowsSource( P1, cID, O ) @ #j)
 ∧
  ∃ P2 #k. (ProxyKnowsDest( P2, cID, S )[-] @ #k) ∧ P1 = P2"
*/
simplify
solve( !Proxy( $Pa ) ▶₁ #i )
  case Proxy_Spawn
  solve( !Proxy( $Pb ) ▶₂ #i )
    case Proxy_Spawn
    solve( !Proxy( $Pc ) ▶₃ #i )
      case Proxy_Spawn
      solve( ProxyKnowsSource( P1, ~circuitID, $O ) @ #j )
        case Client_1_connect_Pa
        solve( State_O0( $O, $Pa.1, $Pb.1, $Pc.1, $S.1, ~circuitID
               ) ▶₀ #j )
          case Sys_init
