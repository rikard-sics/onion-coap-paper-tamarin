                                                    solve( !KU( prot(<
                                                                      senc(<'EDHOC', $O.1, $P, 
                                                                            ~runID>,
                                                                           g(~mk.3, ~ms.3,
                                                                             $P_recipientID_from_source.1,
                                                                             'Key')), 
