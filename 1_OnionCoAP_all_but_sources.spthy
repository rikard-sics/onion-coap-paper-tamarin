            case Proxy_first_3a_forward
            solve( State_P1_decrypted_once( $Pa,
                                            <'please_forward', $S, payload>, $source, %counter,
                                            ~circuitID
                   ) ▶₀ #k )
              case Proxy_all_1_decrypt
              solve( !KU( prot(<
                                senc(<'please_forward', $S, payload>,
