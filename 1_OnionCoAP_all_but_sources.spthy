lemma OSCOREsecure [reuse]:
  all-traces
  "∀ k s x y #i #j.
    ((!KU( g(k, s, x, y) ) @ #i) ∧ (Key( k ) @ #j)) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ k s x y #i #j. (!KU( g(k, s, x, y) ) @ #i) ∧ (Key( k ) @ #j)"
*/
simplify
solve( Key( k ) @ #j )
  case EDHOC_magic_case_1
  solve( !KU( g(~mk, s, x, y) ) @ #i )
    case c_g
    solve( !KU( ~mk ) @ #vk.7 )
      case Proxy_notFirst_3b_edhoc
      by contradiction
    next
      case Server_1_decryptAndEdhoc
      by contradiction
    qed
  qed
next
  case EDHOC_magic_case_2
  solve( !KU( g(~ms, s, x, y) ) @ #i )
    case c_g
    solve( !KU( ~ms ) @ #vk.7 )
      case Proxy_notFirst_3b_edhoc
      by contradiction
    next
      case Server_1_decryptAndEdhoc
      by contradiction
    qed
  qed
qed

lemma oneCircuitID_A [reuse]:
  all-traces
  "∀ P cID s #i.
    (ProxyKnowsSource( P, cID, s ) @ #i) ⇒
    (∃ O S #j. Circuit( O, S, cID ) @ #j)"
/*
guarded formula characterizing all counter-examples:
"∃ P cID s #i.
  (ProxyKnowsSource( P, cID, s ) @ #i)
 ∧
  ∀ O S #j. (Circuit( O, S, cID ) @ #j) ⇒ ⊥"
*/
simplify
solve( ProxyKnowsSource( P, cID, s ) @ #i )
  case Client_1_connect_Pa
  solve( State_O0( $O, $Pa, $Pb, $Pc, $S, ~circuitID ) ▶₀ #i )
    case Sys_init
    by contradiction
  qed
next
  case Proxy_all_1_decrypt
  solve( !KU( prot(<
                    senc(outer_plaintext,
                         g(mk_s, ms_s, $P_recipientID_from_source, 'Key')), 
                    <'AAD', $P_recipientID_from_source, %counter>, ~circuitID>,
                   g(mk_s, ms_s, $P_recipientID_from_source, 'Key'),
                   g(mk_s, ms_s, 'emptybytestring', 'IV'))
         ) @ #vk.5 )
    case Client_2_connect_Pb
    by contradiction
  next
    case Client_3_connect_Pc
    by contradiction
  next
    case Client_4_connect_S
    by contradiction
  next
    case Proxy_first_3a_forward
    solve( !KU( prot(<
                      senc(<'please_forward', $dest, outer_plaintext>,
                           g(~mk.1, ~ms.1, $P_recipientID_from_source.1, 'Key')), 
                      <'AAD', $P_recipientID_from_source.1, %counter>, ~circuitID>,
                     g(~mk.1, ~ms.1, $P_recipientID_from_source.1, 'Key'),
                     g(~mk.1, ~ms.1, 'emptybytestring', 'IV'))
           ) @ #vk.24 )
      case Client_2_connect_Pb
      by contradiction
    next
      case Client_3_connect_Pc
      by contradiction
    next
      case Client_4_connect_S
      by contradiction
    next
      case Proxy_first_3a_forward
      solve( !KU( prot(<
                        senc(<'please_forward', $P.1, 'please_forward', $dest, 
                              outer_plaintext>,
                             g(~mk.2, ~ms.2, $P_recipientID_from_source.2, 'Key')), 
                        <'AAD', $P_recipientID_from_source.2, %counter>, ~circuitID>,
                       g(~mk.2, ~ms.2, $P_recipientID_from_source.2, 'Key'),
                       g(~mk.2, ~ms.2, 'emptybytestring', 'IV'))
             ) @ #vk.43 )
        case Proxy_first_3a_forward
        solve( !KU( prot(<
                          senc(<'please_forward', $source.1, 'please_forward', $P.1, 
                                'please_forward', $dest, outer_plaintext>,
                               g(~mk.3, ~ms.3, $P_recipientID_from_source.3, 'Key')), 
                          <'AAD', $P_recipientID_from_source.3, %1>, ~circuitID>,
                         g(~mk.3, ~ms.3, $P_recipientID_from_source.3, 'Key'),
                         g(~mk.3, ~ms.3, 'emptybytestring', 'IV'))
               ) @ #vk.58 )
          case c_prot
          by contradiction
        qed
      next
        case Proxy_notFirst_3a_forward
        solve( !KU( prot(<
                          senc(<
                                prot(<
                                      senc(<'please_forward', $source.1, 'please_forward', $P.1, 
                                            'please_forward', $dest, outer_plaintext>,
                                           g(~mk.3, ~ms.3, $P_recipientID_from_origin, 'Key')), 
                                      'AAD', $P_recipientID_from_source.3>,
                                     g(~mk.3, ~ms.3, $P_recipientID_from_origin, 'Key'),
                                     g(~mk.3, ~ms.3, 'emptybytestring', 'IV')), 
                                senc(<'please_forward', $source.1, 'please_forward', $P.1, 
                                      'please_forward', $dest, outer_plaintext>,
                                     g(~mk.3, ~ms.3, $P_recipientID_from_origin, 'Key')), 
                                'AAD', $P_recipientID_from_source.3>,
                               g(~mk.4, ~ms.4, $P_recipientID_from_source.4, 'Key')), 
                          <'AAD', $P_recipientID_from_source.4, %1>, ~circuitID>,
                         g(~mk.4, ~ms.4, $P_recipientID_from_source.4, 'Key'),
                         g(~mk.4, ~ms.4, 'emptybytestring', 'IV'))
               ) @ #vk.61 )
          case c_prot
          by contradiction
