                            by sorry
                          next
                            case Proxy_notFirst_3a_forward_case_8
                            by sorry
                          next
                            case Proxy_notFirst_3b_edhoc
                            solve( !KU( prot(<
                                              senc(<'EDHOC', $O.1, $P.1, ~rOC>,
                                                   g(~mk.5, ~ms.5, $P_recipientID_from_source.2,
                                                     'Key')), 
                                              <'AAD', $P_recipientID_from_source.2, %counter>, 
                                              ~circuitID.1>,
                                             g(~mk.5, ~ms.5, $P_recipientID_from_source.2, 'Key'),
                                             g(~mk.5, ~ms.5, 'emptybytestring', 'IV'))
                                   )[+] @ #vk.56 )
                              case Proxy_first_3a_forward
                              by sorry
                            next
                              case Proxy_notFirst_3a_forward
                              solve( !KU( prot(<
                                                senc(<
                                                      prot(<
                                                            senc(<'please_forward', $P.1, 'EDHOC', 
                                                                  $O.1, $P.1, ~rOC>,
                                                                 g(~mk.6, ~ms.6,
                                                                   $P_recipientID_from_origin,
                                                                   'Key')), 
                                                            'AAD', $P_recipientID_from_source.3>,
                                                           g(~mk.6, ~ms.6,
                                                             $P_recipientID_from_origin, 'Key'),
                                                           g(~mk.6, ~ms.6, 'emptybytestring',
                                                             'IV')), 
                                                      senc(<'please_forward', $P.1, 'EDHOC', $O.1, 
                                                            $P.1, ~rOC>,
                                                           g(~mk.6, ~ms.6,
                                                             $P_recipientID_from_origin, 'Key')), 
                                                      'AAD', $P_recipientID_from_source.3>,
                                                     g(~mk.7, ~ms.7, $P_recipientID_from_source.4,
                                                       'Key')), 
                                                <'AAD', $P_recipientID_from_source.4, %counter>, 
                                                ~circuitID.1>,
                                               g(~mk.7, ~ms.7, $P_recipientID_from_source.4, 'Key'),
                                               g(~mk.7, ~ms.7, 'emptybytestring', 'IV'))
                                     )[+] @ #vk.74 )
                                case Proxy_first_3a_forward
                                solve( !KU( prot(<
                                                  senc(<'please_forward', $source, 
                                                        prot(<
                                                              senc(<'please_forward', $P.1, 
                                                                    'EDHOC', $O.1, $P.1, ~rOC>,
                                                                   g(~mk.6, ~ms.6,
                                                                     $P_recipientID_from_origin,
                                                                     'Key')), 
                                                              'AAD', $P_recipientID_from_source.3>,
                                                             g(~mk.6, ~ms.6,
                                                               $P_recipientID_from_origin, 'Key'),
                                                             g(~mk.6, ~ms.6, 'emptybytestring',
                                                               'IV')), 
                                                        senc(<'please_forward', $P.1, 'EDHOC', 
                                                              $O.1, $P.1, ~rOC>,
                                                             g(~mk.6, ~ms.6,
                                                               $P_recipientID_from_origin, 'Key')), 
                                                        'AAD', $P_recipientID_from_source.3>,
                                                       g(~mk.8, ~ms.8, $P_recipientID_from_source.5,
                                                         'Key')), 
                                                  <'AAD', $P_recipientID_from_source.5, %counter>, 
                                                  ~circuitID.1>,
                                                 g(~mk.8, ~ms.8, $P_recipientID_from_source.5,
                                                   'Key'),
                                                 g(~mk.8, ~ms.8, 'emptybytestring', 'IV'))
                                       )[+] @ #vk.91 )
                                  case Client_3_connect_Pc
                                  solve( !KU( senc(<'please_forward', $P, 
                                                    prot(<
                                                          senc(<'please_forward', $Pc, 'EDHOC', $O, 
                                                                $Pc, ~rOC>,
                                                               g(~mk.4, ~ms.4,
                                                                 $P_recipientID_from_origin,
                                                                 'Key')), 
                                                          'AAD', $P_recipientID_from_origin>,
                                                         g(~mk.4, ~ms.4, $P_recipientID_from_origin,
                                                           'Key'),
                                                         g(~mk.4, ~ms.4, 'emptybytestring', 'IV')), 
                                                    senc(<'please_forward', $Pc, 'EDHOC', $O, $Pc, 
                                                          ~rOC>,
                                                         g(~mk.4, ~ms.4, $P_recipientID_from_origin,
                                                           'Key')), 
                                                    'AAD', $P_recipientID_from_origin>,
                                                   g(~mk.3, ~ms.3, $P_recipientID_from_source.1,
                                                     'Key'))
                                         )[+] @ #vk.79 )
                                    case Client_3_connect_Pc
                                    solve( !KU( senc(<
                                                      prot(<
                                                            senc(<'please_forward', $Pc, 'EDHOC', 
                                                                  $O, $Pc, ~rOC>,
                                                                 g(~mk.4, ~ms.4,
                                                                   $P_recipientID_from_origin,
                                                                   'Key')), 
                                                            'AAD', $P_recipientID_from_origin>,
                                                           g(~mk.4, ~ms.4,
                                                             $P_recipientID_from_origin, 'Key'),
                                                           g(~mk.4, ~ms.4, 'emptybytestring',
                                                             'IV')), 
                                                      senc(<'please_forward', $Pc, 'EDHOC', $O, 
                                                            $Pc, ~rOC>,
                                                           g(~mk.4, ~ms.4,
                                                             $P_recipientID_from_origin, 'Key')), 
