lemma executable_C:
  exists-trace
  "∃ O A B C S rOC cID #i #j #k.
    ((System( O, A, B, C, S, cID ) @ #i) ∧
     (EdhocRequested( O, C, rOC ) @ #j)) ∧
    (EdhocCompleted( O, C, rOC ) @ #k)"
/*
guarded formula characterizing all satisfying traces:
"∃ O A B C S rOC cID #i #j #k.
  (System( O, A, B, C, S, cID ) @ #i) ∧
  (EdhocRequested( O, C, rOC ) @ #j) ∧
  (EdhocCompleted( O, C, rOC ) @ #k)"
*/
by sorry

lemma executable_S:
  exists-trace
  "∃ O A B C S rOS cID #i #j #k.
    ((System( O, A, B, C, S, cID ) @ #i) ∧
     (EdhocRequested( O, S, rOS ) @ #j)) ∧
    (EdhocCompleted( O, S, rOS ) @ #k)"
/*
guarded formula characterizing all satisfying traces:
"∃ O A B C S rOS cID #i #j #k.
  (System( O, A, B, C, S, cID ) @ #i) ∧
  (EdhocRequested( O, S, rOS ) @ #j) ∧
  (EdhocCompleted( O, S, rOS ) @ #k)"
*/
simplify
solve( !Proxy( $Pa ) ▶₁ #i )
  case Proxy_Spawn
  solve( !Proxy( $Pb ) ▶₂ #i )
    case Proxy_Spawn
    solve( !Proxy( $Pc ) ▶₃ #i )
      case Proxy_Spawn
      solve( EdhocRequested( $O, $S, ~runID ) @ #j.1 )
        case Client_1_connect_Pa
        by sorry
      next
        case Client_2_connect_Pb
        by sorry
      next
        case Client_3_connect_Pc
        by sorry
      next
        case Client_4_connect_S
        solve( State_O3( $O, $Pa.1, $Pb.1, $Pc.1, $S, ~circuitID.1, rOA,
                         rOB, rOC
               ) ▶₀ #j )
          case Client_3_connect_Pc
          solve( !KU( ~runID )[-] @ #vk.13 )
            case Client_1_connect_Pa
            solve( !KU( ~rOB )[-] @ #vk.16 )
              case Client_2_connect_Pb
              by sorry
            next
              case Proxy_first_3a_forward_case_1
              by sorry
            next
              case Proxy_first_3a_forward_case_2
              by sorry
            next
              case Proxy_first_3a_forward_case_3
              by sorry
            next
              case Proxy_first_3a_forward_case_4
              by sorry
            next
              case Proxy_notFirst_3a_forward_case_1
              by sorry
            next
              case Proxy_notFirst_3a_forward_case_2
              by sorry
            next
              case Proxy_notFirst_3a_forward_case_3
              by sorry
            next
              case Proxy_notFirst_3a_forward_case_4
              by sorry
            next
              case Proxy_notFirst_3b_edhoc
              solve( !KU( prot(<
                                senc(<'EDHOC', $O.1, $P, ~rOB>,
                                     g(~mk.3, ~ms.3, $P_recipientID_from_source, 'Key')), 
                                <'AAD', $P_recipientID_from_source, %counter>, ~circuitID.1>,
                               g(~mk.3, ~ms.3, $P_recipientID_from_source, 'Key'),
                               g(~mk.3, ~ms.3, 'emptybytestring', 'IV'))
                     )[+] @ #vk.25 )
                case Proxy_first_3a_forward
                solve( !KU( prot(<
                                  senc(<'please_forward', $P, 'EDHOC', $O.1, $P, ~rOB>,
                                       g(~mk.4, ~ms.4, $P_recipientID_from_source.1, 'Key')), 
                                  <'AAD', $P_recipientID_from_source.1, %counter>, ~circuitID.1>,
                                 g(~mk.4, ~ms.4, $P_recipientID_from_source.1, 'Key'),
                                 g(~mk.4, ~ms.4, 'emptybytestring', 'IV'))
                       )[+] @ #vk.42 )
                  case Client_2_connect_Pb
                  solve( !KU( senc(<'please_forward', $P, 'EDHOC', $O, $P, ~rOB>,
                                   g(~mk.2, ~ms.2, $P_recipientID_from_source.1, 'Key'))
                         )[+] @ #vk.38 )
                    case Client_2_connect_Pb
                    solve( !KU( senc(<'EDHOC', $O, $P, ~rOB>,
                                     g(~mk.1, ~ms.1, $P_recipientID_from_source, 'Key'))
                           )[+] @ #vk.30 )
                      case Proxy_first_3a_forward
                      solve( !KU( prot(<
